{
  "name": "ufc-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "UFC Picks PWA \u2014 optional static-asset minification build",
  "scripts": {
    "build": "node build.mjs",
    "check:web": "node tests/check-web.mjs",
    "check:functions": "node tests/check-functions.mjs",
    "smoke": "node tests/smoke.mjs",
    "check:tap": "node tests/notification-tap.mjs",
    "check:audience": "node tests/trash-audience.mjs",
    "check:prompt": "node tests/trash-prompt.mjs",
    "check:dedup": "node tests/notify-dedup-key.mjs",
    "check:model": "node tests/fight-model.mjs",
    "check:parlay": "node tests/parlay-risk.mjs",
    "verify": "npm run check:web && npm run check:functions && npm run smoke && npm run check:tap && npm run check:audience && npm run check:prompt && npm run check:dedup && npm run check:model && npm run check:parlay"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "html-minifier-terser": "^7.2.0",
    "playwright": "^1.56.0",
    "terser": "^5.31.0"

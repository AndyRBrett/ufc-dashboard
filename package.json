{
  "name": "ufc-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "UFC Picks PWA — optional static-asset minification build",
  "scripts": {
    "build": "node build.mjs",
    "check:web": "node tests/check-web.mjs",
    "check:functions": "node tests/check-functions.mjs",
    "smoke": "node tests/smoke.mjs",
    "check:tap": "node tests/notification-tap.mjs",
    "check:audience": "node tests/trash-audience.mjs",
    "verify": "npm run check:web && npm run check:functions && npm run smoke && npm run check:tap && npm run check:audience"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "html-minifier-terser": "^7.2.0",
    "playwright": "^1.56.0",
    "terser": "^5.31.0"
  }
}

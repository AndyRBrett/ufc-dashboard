    "check:names": "node tests/fighter-rename.mjs",
    "check:intel": "node tests/check-intel.mjs",
    "check:whatsnew": "node tests/check-whats-new.mjs",
    "check:picks": "node tests/check-picks-restore.mjs",
    "check:prefs": "node tests/check-prefs.mjs",
    "check:kick": "node tests/check-kick-gate.mjs",
    "check:lock": "node tests/check-lock-times.mjs",
    "check:recap": "node tests/check-recap.mjs",
    "check:wrapped": "node tests/check-wrapped.mjs",
